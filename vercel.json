{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/generate.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@gradio/client/dist/**"
    },
    "api/job.js": {
      "maxDuration": 30
    },
    "api/result.js": {
      "maxDuration": 60
    },
    "api/video.js": {
      "maxDuration": 60
    }
  }
}
